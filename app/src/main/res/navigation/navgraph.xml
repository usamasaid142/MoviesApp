<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navgraph"
    app:startDestination="@id/moviesListFragment">

    <fragment
        android:id="@+id/moviesListFragment"
        android:name="com.example.moviesapp.app.ui.fragments.MoviesListFragment"
        android:label="MoviesListFragment"
        tools:layout="@layout/movieslistfragment"
        >
        <action
            android:id="@+id/action_moviesListFragment_to_movieDetailsFragment"
            app:destination="@id/movieDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/movieDetailsFragment"
        android:name="com.example.moviesapp.app.ui.fragments.MovieDetailsFragment"
        android:label="MovieDetailsFragment"
        tools:layout="@layout/movie_detailsfragment"
        >
        <argument
            android:name="movies"
            app:argType="com.example.moviesapp.data.model.Movies"
            app:nullable="true" />
    </fragment>

</navigation>